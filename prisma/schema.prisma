generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "sqlite"
}

model DeviceLog {
  id         String   @id @default(uuid())
  device_id  String
  app_name   String
  event_type String
  latitude   Float
  longitude  Float
  timestamp  DateTime
  created_at DateTime @default(now())
}
